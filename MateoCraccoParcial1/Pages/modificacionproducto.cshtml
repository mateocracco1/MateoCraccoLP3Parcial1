@page
@model MateoCraccoParcial1.Pages.modificacionproductoModel
@{

    ViewData["Title"] = "Modificación de Productos";
    
}
<h1>Modificación de Productos</h1>
<p>Ingrese el ID del producto, presione <strong>Buscar</strong> para ver los datos actuales y realizar las modificaciones.</p>

<form method="post">
    <!-- Preservar datos actuales en campos ocultos -->
    <input type="hidden" asp-for="Encontrado" />
    <input type="hidden" asp-for="NombreActual" />
    <input type="hidden" asp-for="PrecioActual" />
    <input type="hidden" asp-for="CategoriaActual" />

    <p>
        <label><strong>ID del Producto:</strong></label><br />
        <input type="number" asp-for="IdProducto" required style="width: 120px;" />
        <button type="submit" name="Accion" value="Buscar">Buscar</button>
    </p>

    <hr />

    <!--  datos actuales  -->
    @if (Model.Encontrado)
    {
        <div style="background-color: #f8f9fa; border: 1px solid #dee2e6; padding: 12px; margin-bottom: 15px; border-radius: 4px;">
            <h4>Valores actuales en la base de datos:</h4>
            <p><strong>Nombre actual:</strong> @Model.NombreActual</p>
            <p><strong>Precio actual:</strong> $@Model.PrecioActual?.ToString("N2")</p>
            <p><strong>Categoría actual:</strong> @Model.CategoriaActual</p>
        </div>
    }

    <h3>Nuevos valores / Edición:</h3>

    <p>
        <label>Nombre del Producto:</label><br />
        <input type="text" asp-for="Nombre" style="width: 320px;" />
    </p>

    <p>
        <label>Precio:</label><br />
        <input type="number" step="0.01" asp-for="Precio" style="width: 160px;" />
    </p>

    <p>
        <label>Categoría asignada:</label><br />
        <select asp-for="IdCategoria" asp-items="Model.Categorias" style="width: 260px;">
            <option value="">-- Seleccionar categoría --</option>
        </select>
    </p>

    <p>
        <button type="submit" name="Accion" value="Modificar">Guardar Modificación</button>
    </p>
</form>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <p><strong>@Model.Mensaje</strong></p>
}

<br />
<p>
    <a href="/Index">Volver a la página principal</a>
</p>