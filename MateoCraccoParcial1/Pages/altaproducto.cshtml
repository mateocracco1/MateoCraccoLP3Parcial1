@page
@model MateoCraccoParcial1.Pages.altaproductoModel
@{
    ViewData["Title"] = "Alta de Productos";
}
<h1>Alta de Productos</h1>

<form method="post">
    <p>
        <label>Nombre del Producto:</label><br />
        <input type="text" asp-for="Nombre" required />
    </p>

    <p>
        <label>Precio:</label><br />
        <input type="number" step="0.01" asp-for="Precio" required />
    </p>

    <p>
        <label>Categoría:</label><br />
        <select asp-for="IdCategoria" asp-items="Model.Categorias">
            <option value="">-- Seleccione una categoría --</option>
        </select>
    </p>

    <p>
        <button type="submit">Confirmar</button>
    </p>
</form>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <p><strong>@Model.Mensaje</strong></p>
}

<p>
    <a href="/Index">Volver a la página principal</a>
</p>